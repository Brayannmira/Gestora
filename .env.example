# Application runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# SQLite database
DB_FILE=./data/gestora.sqlite

# Session security and allowed origins. Production secrets belong in the host's secret store.
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:5173
# Optional trial duration in days (1-365; default 14).
TRIAL_DAYS=14

# Leave empty for the local Vite proxy. For separate hosting, set the API origin.
VITE_API_URL=

# Gmail SMTP (use a Google App Password, never your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only once by `npm run create:super-admin`. Remove these values after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
